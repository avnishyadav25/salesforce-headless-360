# Copy to .env.local and fill in. Never commit .env.local.
# Every value marked "verify in your org" is documented in ../README.md.

# ---------------------------------------------------------------------------
# Salesforce OAuth (External Client App, Authorization Code + PKCE)
# ---------------------------------------------------------------------------
# Authorization server that issues tokens for your org. It must match the
# authorization server your MCP server URLs advertise:
#   Production / Developer Edition : https://login.salesforce.com
#   Sandbox / scratch org          : https://test.salesforce.com
#   My Domain (recommended)        : https://<mydomain>.my.salesforce.com
#                                    (use with the /d/<mydomain>/... MCP URLs)
SF_LOGIN_URL=https://login.salesforce.com

# Consumer Key of the External Client App (Settings > OAuth Settings > Consumer Key and Secret).
SF_CLIENT_ID=

# Optional. Only set it if the ECA has "Require secret for Web Server Flow" /
# "Require secret for Refresh Token Flow" enabled (recommended for server-side web apps).
SF_CLIENT_SECRET=

# Must exactly match a Callback URL on the External Client App.
SF_CALLBACK_URL=http://localhost:3000/api/auth/salesforce/callback

# Hosted MCP servers (GA) use exactly these two scopes. The beta used
# "api sfap_api refresh_token einstein_gpt_api"; those do not work with the GA URLs.
SF_SCOPES=mcp_api refresh_token

# Optional, verify in your org: RFC 8707 resource indicator(s), comma-separated.
# Leave empty unless your org rejects a token that was not requested for a specific MCP server URL.
SF_OAUTH_RESOURCE=

# The app refreshes the Salesforce access token before sending it to Anthropic
# whenever it is older than this many seconds (or about to expire).
SF_TOKEN_MAX_AGE_SECONDS=900

# ---------------------------------------------------------------------------
# Salesforce Hosted MCP servers
# ---------------------------------------------------------------------------
# Standard server. Copy the exact URL from Setup > MCP Servers (verify in your org).
#   Production/DE : https://api.salesforce.com/platform/mcp/v1/platform/sobject-all
#   Sandbox       : https://api.salesforce.com/platform/mcp/v1/sandbox/platform/sobject-all
#   My Domain DE  : https://api.salesforce.com/platform/mcp/v1/d/<mydomain>/develop/platform/sobject-all
SF_MCP_SOBJECT_URL=https://api.salesforce.com/platform/mcp/v1/platform/sobject-all

# Custom server that wraps this repo's Apex tools (salesforce/ folder). Leave empty to run
# with sobject-all only. Copy the Server URL from Setup > MCP Servers > Headless_Assistant_Tools.
#   Production/DE : https://api.salesforce.com/platform/mcp/v1/custom/Headless_Assistant_Tools
SF_MCP_CUSTOM_URL=

# Tools that change data. They are switched off (mcp_toolset configs) until the user
# approves a specific proposal. Verify the sobject-all names in your org's tool list.
SF_MCP_SOBJECT_WRITE_TOOLS=createSobjectRecord,updateSobjectRecord,updateRelatedRecord,deleteSobjectRecord,deleteRelatedRecord
SF_MCP_CUSTOM_WRITE_TOOLS=createFollowUpTask

# ---------------------------------------------------------------------------
# Anthropic (Messages API + MCP connector)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# MCP connector beta header.
ANTHROPIC_MCP_BETA=mcp-client-2025-11-20
ANTHROPIC_MAX_TOKENS=16000
# Optional: low | medium | high | xhigh | max (API default when empty).
ANTHROPIC_EFFORT=

# ---------------------------------------------------------------------------
# Meeting prep brief (Day 10, POST /api/brief)
# ---------------------------------------------------------------------------
# Overall deadline for one brief in milliseconds: every model call, retry wait and
# pause_turn continuation. Past it the request is aborted and the API answers 504.
# Keep it below the route's maxDuration (300 s).
BRIEF_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
